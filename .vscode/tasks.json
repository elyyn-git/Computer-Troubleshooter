{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Computer Troubleshooter",
            "command": "cl",
            "args": [
                "/nologo",
                "/std:c++17",
                "/EHsc",
                "/utf-8",
                "/D",
                "_WIN32_WINNT=0x0A00",
                "/I",
                "D:/Library/Crow/include",
                "/I",
                "D:/Library/asio/include",
                "/Fe:server.exe",
                "backend/main.cpp",
                "backend/modules/csv.cpp",
                "backend/modules/diagnosis.cpp",
                "backend/modules/history.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}